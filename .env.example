# Скопіюй у .env для локального запуску. На GitHub ці значення йдуть у Settings → Secrets.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
# шлях до файлу ключа сервісного акаунта (локально) або сам JSON (на GitHub)
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
GOOGLE_CALENDAR_ID=you@gmail.com
STATE_KEY=

# необовʼязкові
OPENAI_MODEL=gpt-4o-mini
TIMEZONE=Europe/Kyiv
MORNING_HOUR=8
EVENING_HOUR=20
REMIND_BEFORE_MIN=60
